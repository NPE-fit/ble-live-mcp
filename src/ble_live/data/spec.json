{
  "spec_version": "1.7.0",
  "revdate": "October 28, 2026",
  "source": "ble-live-protocol.adoc",
  "ad_types": {
    "plain": "0xFE",
    "encrypted": "0xFD"
  },
  "data_identifiers": {
    "dpi": "0xFF",
    "dfa": "0xFE",
    "dfd_bit": "0x40"
  },
  "fitness_fields": [
    {
      "index": 0,
      "name": "Heart Rate",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8",
      "units": "1 BPM"
    },
    {
      "index": 1,
      "name": "Cadence",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8",
      "units": "1 RPM"
    },
    {
      "index": 2,
      "name": "Step Rate",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8",
      "units": "steps per minute"
    },
    {
      "index": 3,
      "name": "Stride Rate",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8",
      "units": "strides per minute",
      "notes": "of the foot the device is mounted on striking the ground"
    },
    {
      "index": 4,
      "name": "Active Calories",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16",
      "units": "1 kCal"
    },
    {
      "index": 5,
      "name": "Total Calories",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16",
      "units": "1 kCal"
    },
    {
      "index": 6,
      "name": "Speed",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16",
      "units": "1/100 KPH"
    },
    {
      "index": 7,
      "name": "Accumulated Distance",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16",
      "units": "1m"
    },
    {
      "index": 8,
      "name": "Power",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16",
      "units": "1 W"
    },
    {
      "index": 9,
      "name": "Instantaneous Pace (Time per 500 meters)",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16"
    },
    {
      "index": 10,
      "name": "Workout State",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8",
      "units": "TBD"
    },
    {
      "index": 11,
      "name": "Step Count",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "UInt16",
      "units": "1 Step"
    },
    {
      "index": 12,
      "name": "Stride Count",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "UInt16",
      "units": "1 Stride"
    },
    {
      "index": 13,
      "name": "Temperature",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "UInt16",
      "units": "0.01C"
    },
    {
      "index": 14,
      "name": "Heart Beat Count",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "UInt8",
      "units": "Count"
    },
    {
      "index": 15,
      "name": "Heart Rate Confidence",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "UInt8",
      "units": "1%"
    },
    {
      "index": 16,
      "name": "Power Event Count",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "UInt8",
      "units": "Count, rolls over at 255",
      "notes": "Incremented each time Power is updated, in the same transmit page as Power"
    },
    {
      "index": 17,
      "name": "Accumulated Power",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "UInt16",
      "units": "1 W, rolls over at 65535",
      "notes": "Running sum of the Power value at each Power Event Count increment"
    },
    {
      "index": 254,
      "name": "R-R Intervals",
      "type": "uint16",
      "size_bytes": null,
      "array": true,
      "element_size_bytes": 2,
      "size_raw": "UInt16 per interval",
      "units": "milliseconds per interval",
      "notes": "R-R Intervals should be preceded by the Heart Beat Count in the transmit page. R-R Intervals should always be the last field present in the definition for the DFV so there can be multiple intervals sent in the payload. The decode should process the interval fields until the end of the message is reached."
    },
    {
      "index": 255,
      "name": "Unused",
      "type": null,
      "size_bytes": null,
      "size_raw": ""
    }
  ],
  "meta_fields": [
    {
      "index": 0,
      "name": "Protocol Version",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8"
    },
    {
      "index": 1,
      "name": "Battery Percent",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8",
      "units": "1 %"
    },
    {
      "index": 2,
      "name": "Battery Voltage",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16",
      "units": "0.01 V"
    },
    {
      "index": 3,
      "name": "Model #",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16"
    },
    {
      "index": 4,
      "name": "Hardware Version",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8"
    },
    {
      "index": 5,
      "name": "Firmware Version",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16"
    },
    {
      "index": 6,
      "name": "Bootloader Version",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "Uint16"
    },
    {
      "index": 7,
      "name": "Supported BLE Connections",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8"
    },
    {
      "index": 8,
      "name": "Available BLE Connections",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "Uint8"
    },
    {
      "index": 9,
      "name": "RSSI Measured at 1m",
      "type": "int8",
      "size_bytes": 1,
      "size_raw": "Sint8"
    },
    {
      "index": 10,
      "name": "Equipment Type",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "UInt8",
      "units": "Refer to table Table 7: Equipment Type"
    },
    {
      "index": 11,
      "name": "ANT+ Manufacturer ID",
      "type": "uint16",
      "size_bytes": 2,
      "size_raw": "UInt16",
      "units": "Refer to FIT SDK for assigned values"
    },
    {
      "index": 12,
      "name": "LED Intensity",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "UInt8",
      "units": "1%"
    },
    {
      "index": 13,
      "name": "Zone Threshold FDI",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "UInt8"
    },
    {
      "index": 14,
      "name": "Zone Threshold Size",
      "type": "uint8",
      "size_bytes": 1,
      "size_raw": "UInt8",
      "units": "Size in bits of the values in the threshold array"
    },
    {
      "index": 15,
      "name": "Zone Thresholds",
      "type": null,
      "size_bytes": null,
      "variable": true,
      "size_raw": "sizeof(FDI type)",
      "units": "An array of values defining the set points of the zone adjustment handles. The thresholds are arrange in order starting at index 0. All thresholds are set in one DFV.",
      "notes": "Zone Thresholds should be preceded by the size in bits to indicate how large each of the zone values in the array."
    },
    {
      "index": 255,
      "name": "Unused",
      "type": null,
      "size_bytes": null,
      "size_raw": ""
    }
  ],
